{
  "name": "cloudagents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "!packages/kestrel-box"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:server": "bun run --filter @cloudagents/server dev",
    "dev:app": "bun run --filter @cloudagents/app dev",
    "build:app": "bun run --filter @cloudagents/app build && bun run --filter @cloudagents/mobile build:web",
    "build:box": "bun scripts/build-box.ts",
    "dev:mobile": "bun run --filter @cloudagents/mobile start",
    "build:desktop": "bun run --filter @cloudagents/desktop build",
    "dist:desktop": "bun run --filter @cloudagents/desktop dist",
    "dev:desktop": "bun scripts/dev-desktop.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "wrangler": "^4"
  }
}
