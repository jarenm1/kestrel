---
import Base from "../layouts/Base.astro"
import { APP_URL } from "../config"

const plans = [
  {
    name: "Hobby",
    price: "$0",
    period: "forever",
    blurb: "Try an agent box on a side project.",
    features: ["1 box, shared compute", "10 agent hours / month", "Live desktop at 720p", "Bring your own model key"],
    cta: "Start free",
    featured: false,
  },
  {
    name: "Pro",
    price: "$29",
    period: "per month",
    blurb: "A dedicated box for daily agent work.",
    features: [
      "1 dedicated box",
      "200 agent hours / month",
      "Live desktop at 1080p, 60 fps",
      "Parallel tasks with isolated worktrees",
      "Priority support",
    ],
    cta: "Go Pro",
    featured: true,
  },
  {
    name: "Team",
    price: "$99",
    period: "per seat / month",
    blurb: "Boxes for the whole team, managed in one place.",
    features: [
      "Dedicated box per seat",
      "Unlimited agent hours (fair use)",
      "GPU-accelerated desktops",
      "Shared repos and connections",
      "SSO and audit log",
    ],
    cta: "Contact us",
    featured: false,
  },
]

const faq = [
  {
    q: "What exactly is a box?",
    a: "A machine we run for you, with a sandbox per agent run, a desktop per task, and the tools your agent needs already installed. You rent it the way you'd rent a game server.",
  },
  {
    q: "Do I pay for model usage here?",
    a: "No. Connect your own Anthropic or OpenAI key. Kestrel brokers it to the agent without ever exposing the key inside the sandbox.",
  },
  {
    q: "What counts as an agent hour?",
    a: "Wall-clock time an agent run is active on your box. Idle boxes and open desktops without a run don't count.",
  },
  {
    q: "Is billing live?",
    a: "Not yet. Kestrel is a hackathon demo. Plans show where the product is headed; everyone gets in free for now.",
  },
]
---

<Base title="Pricing · Kestrel" description="Simple plans for renting an agent box. Bring your own model key.">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="text-center">
      <h1 class="text-4xl font-semibold tracking-tight">Pricing</h1>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground">
        Rent the box, bring your own model key. No servers to manage, cancel anytime.
      </p>
      <p class="mt-4 inline-block rounded-full border border-warning/50 bg-warning/10 px-3 py-1 text-xs text-warning">
        Demo pricing. Billing is not live and every plan is free during the hackathon.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        plans.map((plan) => (
          <div
            class:list={[
              "flex flex-col rounded-xl border bg-card p-6",
              plan.featured && "border-primary shadow-xl shadow-primary/10",
            ]}
          >
            <div class="flex items-center gap-2">
              <h2 class="font-semibold">{plan.name}</h2>
              {plan.featured && (
                <span class="rounded-full bg-primary/15 px-2 py-0.5 text-xs text-primary">Most popular</span>
              )}
            </div>
            <p class="mt-1 text-sm text-muted-foreground">{plan.blurb}</p>
            <p class="mt-6 flex items-baseline gap-1.5">
              <span class="text-4xl font-semibold tracking-tight">{plan.price}</span>
              <span class="text-sm text-muted-foreground">{plan.period}</span>
            </p>
            <ul class="mt-6 flex flex-1 flex-col gap-2.5 text-sm">
              {plan.features.map((feature) => (
                <li class="flex gap-2">
                  <span class="text-success">✓</span>
                  {feature}
                </li>
              ))}
            </ul>
            <a href={APP_URL} class:list={["btn mt-8", plan.featured ? "btn-primary" : "btn-outline"]}>
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h2 class="text-center text-2xl font-semibold tracking-tight">Questions</h2>
      <dl class="mt-10 divide-y rounded-xl border bg-card">
        {
          faq.map((item) => (
            <div class="p-6">
              <dt class="font-medium">{item.q}</dt>
              <dd class="mt-2 text-sm text-muted-foreground">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
