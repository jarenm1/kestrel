{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Assets-only Worker: serves the static Astro build on the apex and www.
  "name": "kestrel-site",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "kestrel-agent.com", "custom_domain": true },
    { "pattern": "www.kestrel-agent.com", "custom_domain": true }
  ]
}
