{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kestrel",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/box/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "vars": {
    "ALLOWED_GITHUB_LOGINS": "jarenm1"
  },
  // PR/branch Previews (`wrangler preview`). Each Preview gets its own Hub Durable Object
  // namespace, so it never shares sessions, connections or the box slot with production.
  // vars and secrets are not inherited from the top level.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "HUB", "class_name": "Hub" }]
    },
    "vars": {
      "ALLOWED_GITHUB_LOGINS": "jarenm1"
    }
  }
}
