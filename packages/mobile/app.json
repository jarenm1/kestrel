{
  "expo": {
    "name": "Kestrel",
    "slug": "kestrel-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kestrel",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0e1014"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kestrel.mobile"
    },
    "android": {
      "package": "com.kestrel.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Kestrel",
      "backgroundColor": "#0a0a0b",
      "themeColor": "#0a0a0b"
    },
    "experiments": {
      "baseUrl": "/m"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router"
    ]
  }
}
